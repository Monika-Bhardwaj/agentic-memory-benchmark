{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-memory-benchmark/v0.1/task.schema.json",
  "title": "SACAM agentic-memory benchmark task (v0.1)",
  "description": "A single frozen synthetic task. Validates schema conformance of the benchmark task set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "benchmark_version",
    "category",
    "difficulty",
    "description",
    "scenario",
    "events",
    "query",
    "distractor_event_ids",
    "ground_truth",
    "success_criterion",
    "expected_memory_operation",
    "memory_trace",
    "required_item_ids",
    "failure_categories",
    "seed"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[A-E]_[A-Z]+_(?:[0-9]{2}|FX[0-9]{2})$"
    },
    "benchmark_version": { "const": "v0.1" },
    "category": {
      "type": "string",
      "enum": ["retention", "updating", "stale_conflict", "forgetting", "adversarial"]
    },
    "difficulty": { "type": "integer", "enum": [1, 2, 3] },
    "description": { "type": "string" },
    "scenario": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/event" }
    },
    "query": { "type": "string" },
    "distractor_event_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^e[0-9]+$" }
    },
    "ground_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_values", "forbidden_values"],
      "properties": {
        "required_values": { "type": "array", "items": { "type": "string" } },
        "forbidden_values": { "type": "array", "items": { "type": "string" } }
      }
    },
    "success_criterion": { "$ref": "#/$defs/success_criterion" },
    "expected_memory_operation": { "type": "string" },
    "memory_trace": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_item_ids": {
      "type": "array",
      "items": { "type": "string", "pattern": "^m[0-9]+$" }
    },
    "failure_categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/failure_label" },
      "uniqueItems": true
    },
    "seed": { "type": "integer" }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "kind"],
      "properties": {
        "event_id": { "type": "string", "pattern": "^e[0-9]+$" },
        "kind": {
          "type": "string",
          "enum": ["user_message", "memory_update", "memory_forget", "query"]
        },
        "text": { "type": "string" },
        "item": { "$ref": "#/$defs/memory_item" },
        "item_id": { "type": "string", "pattern": "^m[0-9]+$" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "memory_update" } } },
          "then": {
            "required": ["item_id", "item"],
            "properties": { "text": {} }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "memory_forget" } } },
          "then": {
            "required": ["item_id"],
            "properties": { "item": false }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "query" } } },
          "then": {
            "required": ["text"],
            "properties": { "item": false, "item_id": false }
          }
        }
      ]
    },
    "memory_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "content"],
      "properties": {
        "item_id": { "type": "string", "pattern": "^m[0-9]+$" },
        "content": { "type": "string" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "timestamp", "confidence", "adversarial", "authority"],
          "properties": {
            "source": { "type": "string" },
            "timestamp": { "type": "integer", "minimum": 0 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "adversarial": { "type": "boolean" },
            "authority": { "type": "string" }
          }
        }
      }
    },
    "success_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "values", "forbid", "normalization"],
      "properties": {
        "type": { "const": "contains_all" },
        "values": { "type": "array", "items": { "type": "string" } },
        "forbid": { "type": "array", "items": { "type": "string" } },
        "normalization": { "type": "string", "enum": ["lower_strip", "none"] }
      }
    },
    "failure_label": {
      "type": "string",
      "enum": [
        "RETENTION_FAILURE",
        "UPDATE_FAILURE",
        "STALE_MEMORY_FAILURE",
        "FORGETTING_FAILURE",
        "RETRIEVAL_FAILURE",
        "REASONING_FAILURE",
        "ADVERSARIAL_MEMORY_FAILURE",
        "IRRELEVANT_MEMORY_INTERFERENCE",
        "OTHER"
      ]
    }
  }
}