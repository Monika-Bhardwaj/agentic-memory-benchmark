# Copy to `.env` and fill in. Never commit your real keys.
# Used only by the LIVE model adapter. The mock model needs nothing.

# OpenAI-compatible endpoint (chat completions). Works with many providers.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Optional overrides for the live adapter.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2